# Copy to .env and adjust. .env is gitignored - never commit real values.

# development | testing | production
ENVIRONMENT=development

# Required when ENVIRONMENT=production; the app refuses to start without it.
# Outside production an ephemeral key is generated per process.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated. Do not use "*" in production - the API sends credentials.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Async driver required: sqlite+aiosqlite / postgresql+asyncpg
DATABASE_URL=sqlite+aiosqlite:///./fraud_detection.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Directory of *.joblib artefacts. When empty the API serves the
# heuristic-baseline scorer and says so in /api/v1/health.
# Treat as trusted infrastructure: joblib deserialises via pickle.
MODEL_PATH=./models

LOG_LEVEL=INFO
LOG_FILE=fraud_detection.log
ENABLE_FILE_LOGGING=true

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Enable ONLY behind a proxy that overwrites X-Forwarded-For. If the app is
# directly reachable, this header is attacker-controlled and enabling it lets
# any client bypass rate limiting entirely.
TRUST_PROXY_HEADERS=false

PORT=8000
MAX_BATCH_SIZE=1000
REQUEST_TIMEOUT=30
